---
// Zde si definujeme, jaká data z index.astro očekáváme
export interface Props {
  email: string;
  phone: string;
  phoneContactName: string;
  facebookUrl: string;
  instagramUrl: string;
}

// Vytažení dat do proměnných
const { email, phone, phoneContactName, facebookUrl, instagramUrl } =
  Astro.props;
---

<section id="kontakt" class="section container">
  <h2 class="section-title-lined">Kontakt</h2>

  <div class="contact-grid">
    <!-- 1. SLOUPEC: Jméno, Telefon a fakturace -->
    <div class="contact-col">
      {phoneContactName && <p class="primary-text">{phoneContactName}</p>}
      {phone && <p class="primary-text">tel.: {phone}</p>}
    </div>

    <!-- 2. SLOUPEC: E-mail a Web -->
    <div class="contact-col">
      {
        email && (
          <p class="primary-text">
            e-mail: <a href={`mailto:${email}`}>{email}</a>
          </p>
        )
      }
      <!-- Váš web (můžete přepsat na svou skutečnou doménu) -->
      <p class="primary-text"><a href="/">www.clatonia.cz</a></p>
    </div>

    <!-- 3. SLOUPEC: Sociální sítě (Ikonky) -->
    <div class="contact-col contact-socials">
      {
        facebookUrl && (
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
          >
            <svg viewBox="0 0 24 24" class="social-icon">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.469h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.469h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
        )
      }
      {
        instagramUrl && (
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
          >
            <svg viewBox="0 0 24 24" class="social-icon">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Styl nadpisu s linkou (využijeme stejný jako u nabídky, abychom drželi konzistenci) */
  .section-title-lined {
    font-size: 2.2rem;
    color: #a0a0a0;
    border-bottom: 1px solid #ccc; /* Horní linka z obrázku */
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  /* Obal pro ty 3 sloupce */
  .contact-grid {
    display: flex;
    justify-content: space-between;
    align-items: center; /* Zarovná texty i ikonky svisle na střed */
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #ccc; /* Dolní linka z obrázku */
  }

  .contact-col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  /* Styl hlavních textů (jméno, e-mail) - šedá barva jako na obrázku */
  .primary-text {
    margin: 0;
    color: #777;
    font-size: 1.1rem;
  }

  .primary-text a {
    color: #777;
    text-decoration: none;
  }

  .primary-text a:hover {
    color: #b38b22; /* Při najetí myší zezlátne */
  }

  /* Doplňkové informace (IČO) */
  .billing-info {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    color: #a0a0a0;
  }

  /* Ikonky sociálních sítí */
  .contact-socials {
    flex-direction: row;
    gap: 1.5rem;
  }

  .social-icon {
    width: 36px;
    height: 36px;
    fill: #b38b22; /* Ta zlatavá barva z obrázku */
    transition: opacity 0.2s ease-in-out;
  }

  .social-icon:hover {
    opacity: 0.7;
  }

  /* Přeskládání na telefonech (pod sebou) */
  @media (max-width: 768px) {
    .contact-grid {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
  }
</style>
